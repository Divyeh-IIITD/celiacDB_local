<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Celiac DB</title>
  <link rel="icon" href="/logo.jpeg" />

  <!-- CRITICAL: Enhanced Navbar & Footer styles -->
  <style>
    /* BULLETPROOF ENHANCED NAVBAR - Professional Design */

    * {
      box-sizing: border-box;
    }

    /* Force reset any existing navbar/header styles that might conflict */
    header,
    nav,
    .navbar,
    .nav-container,
    .nav-brand,
    .nav-links,
    .nav-link {
      all: unset !important;
    }

    body {
      margin: 0 !important;
      padding-top: 70px !important;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      font-display: swap;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%) !important;
      min-height: 100vh;
    }

    /* MAXIMUM SPECIFICITY ENHANCED NAVBAR */
    html body header nav.navbar {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: 100% !important;
      height: 70px !important;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%) !important;
      backdrop-filter: blur(25px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(25px) saturate(180%) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
      box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3) !important;
      z-index: 99999 !important;
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
      box-sizing: border-box !important;
      display: block !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Inter", sans-serif !important;
    }

    html body header nav.navbar.scrolled {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%) !important;
      box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.3) !important;
    }

    html body header nav.navbar .nav-container {
      max-width: 1400px !important;
      margin: 0 auto !important;
      height: 100% !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      padding: 0 32px !important;
      box-sizing: border-box !important;
    }

    html body header nav.navbar .nav-container .nav-brand {
      display: flex !important;
      align-items: center !important;
      gap: 16px !important;
      text-decoration: none !important;
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
      color: inherit !important;
      cursor: pointer !important;
    }

    html body header nav.navbar .nav-container .nav-brand:hover {
      transform: translateY(-2px) scale(1.02) !important;
    }

    html body header nav.navbar .nav-container .nav-brand .nav-logo {
      width: 42px !important;
      height: 42px !important;
      border-radius: 12px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4) !important;
      position: relative !important;
      overflow: hidden !important;
      background: rgba(255, 255, 255, 0.1) !important;
      backdrop-filter: blur(10px) !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
    }

    html body header nav.navbar .nav-container .nav-brand .nav-logo img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      border-radius: 10px !important;
    }

    html body header nav.navbar .nav-container .nav-brand .nav-logo::before {
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      left: -100% !important;
      width: 100% !important;
      height: 100% !important;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent) !important;
      transition: left 0.6s !important;
    }

    html body header nav.navbar .nav-container .nav-brand:hover .nav-logo::before {
      left: 100% !important;
    }

    html body header nav.navbar .nav-container .nav-brand div .nav-title {
      font-size: 20px !important;
      font-weight: 700 !important;
      color: white !important;
      margin: 0 !important;
      letter-spacing: -0.5px !important;
      line-height: 1.2 !important;
    }

    html body header nav.navbar .nav-container .nav-brand div .nav-subtitle {
      font-size: 12px !important;
      color: rgba(255, 255, 255, 0.9) !important;
      font-weight: 500 !important;
      margin: 0 !important;
      line-height: 1 !important;
    }

    html body header nav.navbar .nav-container .nav-links {
      display: flex !important;
      align-items: center !important;
      gap: 12px !important;
      list-style: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    html body header nav.navbar .nav-container .nav-links .nav-link {
      padding: 10px 18px !important;
      border-radius: 25px !important;
      text-decoration: none !important;
      color: white !important;
      font-weight: 600 !important;
      font-size: 14px !important;
      transition: all 0.3s ease !important;
      position: relative !important;
      overflow: hidden !important;
      display: inline-block !important;
      line-height: 1.4 !important;
      cursor: pointer !important;
      background: rgba(255, 255, 255, 0.15) !important;
      border: 1px solid rgba(255, 255, 255, 0.3) !important;
      backdrop-filter: blur(10px) !important;
    }

    html body header nav.navbar .nav-container .nav-links .nav-link::before {
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      left: -100% !important;
      right: 0 !important;
      bottom: 0 !important;
      background: rgba(255, 255, 255, 0.25) !important;
      transition: left 0.3s ease !important;
      border-radius: 25px !important;
      z-index: -1 !important;
    }

    html body header nav.navbar .nav-container .nav-links .nav-link:hover::before {
      left: 0 !important;
    }

    html body header nav.navbar .nav-container .nav-links .nav-link:hover {
      color: #667eea !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2) !important;
      background: rgba(255, 255, 255, 0.9) !important;
      border-color: rgba(255, 255, 255, 0.6) !important;
    }

    html body header nav.navbar .nav-container .nav-links .nav-link.active {
      background: rgba(255, 255, 255, 0.9) !important;
      color: #667eea !important;
      box-shadow: 0 8px 25px rgba(255, 255, 255, 0.3) !important;
      border-color: rgba(255, 255, 255, 0.6) !important;
      font-weight: 700 !important;
    }

    html body header nav.navbar .nav-container .nav-links .nav-link.active::before {
      display: none !important;
    }

    /* Professional Dropdown for Custom Docking */
    .nav-dropdown {
      position: relative !important;
      display: inline-block !important;
    }

    .nav-dropdown-menu {
      display: none;
      position: absolute !important;
      top: 100% !important;
      right: 0 !important;
      min-width: 230px !important;
      background: rgba(255, 255, 255, 0.98) !important;
      backdrop-filter: blur(25px) !important;
      -webkit-backdrop-filter: blur(25px) !important;
      border-radius: 14px !important;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22) !important;
      padding: 8px !important;
      margin-top: 8px !important;
      z-index: 100000 !important;
      border: 1px solid rgba(255, 255, 255, 0.7) !important;
    }

    .nav-dropdown:hover .nav-dropdown-menu,
    .nav-dropdown:focus-within .nav-dropdown-menu {
      display: block !important;
      animation: navDropdownFade 0.25s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    }

    @keyframes navDropdownFade {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .nav-dropdown-item {
      display: flex !important;
      align-items: center !important;
      padding: 10px 16px !important;
      color: #2d3748 !important;
      text-decoration: none !important;
      font-size: 13.5px !important;
      font-weight: 600 !important;
      border-radius: 10px !important;
      transition: all 0.2s ease !important;
      white-space: nowrap !important;
    }

    .nav-dropdown-item:hover {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(118, 75, 162, 0.15)) !important;
      color: #667eea !important;
      transform: translateX(4px) !important;
    }

    html body header nav.navbar .nav-container .nav-toggle {
      display: none !important;
      flex-direction: column !important;
      gap: 5px !important;
      background: rgba(255, 255, 255, 0.1) !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      cursor: pointer !important;
      padding: 12px !important;
      border-radius: 10px !important;
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
      backdrop-filter: blur(10px) !important;
    }

    html body header nav.navbar .nav-container .nav-toggle:hover {
      background: rgba(255, 255, 255, 0.2) !important;
      transform: scale(1.05) !important;
    }

    html body header nav.navbar .nav-container .nav-toggle span {
      width: 24px !important;
      height: 3px !important;
      background: linear-gradient(135deg, #667eea, #764ba2) !important;
      border-radius: 2px !important;
      transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
      display: block !important;
    }

    html body header nav.navbar .nav-container .nav-toggle.active span:nth-child(1) {
      transform: rotate(45deg) translate(6px, 6px) !important;
    }

    html body header nav.navbar .nav-container .nav-toggle.active span:nth-child(2) {
      opacity: 0 !important;
      transform: scale(0) !important;
    }

    html body header nav.navbar .nav-container .nav-toggle.active span:nth-child(3) {
      transform: rotate(-45deg) translate(8px, -8px) !important;
    }

    /* Override any Bootstrap or other framework navbar */
    .navbar-brand,
    .navbar-nav,
    .navbar-toggler,
    .navbar-collapse {
      display: none !important;
    }

    /* Ensure our custom navbar is always visible */
    header[role="banner"] {
      display: block !important;
    }

    /* Mobile Navigation */
    @media (max-width: 768px) {
      html body header nav.navbar .nav-container {
        padding: 0 20px !important;
      }

      html body header nav.navbar .nav-container .nav-brand div .nav-title {
        font-size: 18px !important;
      }

      html body header nav.navbar .nav-container .nav-brand div .nav-subtitle {
        display: none !important;
      }

      html body header nav.navbar .nav-container .nav-toggle {
        display: flex !important;
      }

      html body header nav.navbar .nav-container .nav-links {
        position: absolute !important;
        top: 100% !important;
        left: 0 !important;
        right: 0 !important;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%) !important;
        backdrop-filter: blur(30px) saturate(200%) !important;
        -webkit-backdrop-filter: blur(30px) saturate(200%) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2) !important;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3) !important;
        flex-direction: column !important;
        gap: 0 !important;
        padding: 24px !important;
        transform: translateY(-20px) !important;
        opacity: 0 !important;
        visibility: hidden !important;
        transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
      }

      html body header nav.navbar .nav-container .nav-links.active {
        transform: translateY(0) !important;
        opacity: 1 !important;
        visibility: visible !important;
      }

      html body header nav.navbar .nav-container .nav-links .nav-link {
        width: 100% !important;
        text-align: center !important;
        padding: 16px 24px !important;
        margin: 4px 0 !important;
        border-radius: 12px !important;
        color: white !important;
        background: rgba(255, 255, 255, 0.15) !important;
        border: 1px solid rgba(255, 255, 255, 0.3) !important;
      }

      html body header nav.navbar .nav-container .nav-links .nav-link:hover {
        color: #667eea !important;
        background: rgba(255, 255, 255, 0.9) !important;
        border-color: rgba(255, 255, 255, 0.6) !important;
      }

      html body header nav.navbar .nav-container .nav-links .nav-link.active {
        background: rgba(255, 255, 255, 0.9) !important;
        color: #667eea !important;
        border-color: rgba(255, 255, 255, 0.6) !important;
        font-weight: 700 !important;
      }

      .nav-dropdown {
        width: 100% !important;
      }

      .nav-dropdown-menu {
        position: static !important;
        box-shadow: none !important;
        background: rgba(255, 255, 255, 0.12) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        display: block !important;
        padding: 6px !important;
        margin-top: 6px !important;
        width: 100% !important;
      }

      .nav-dropdown-item {
        color: white !important;
        padding: 10px 14px !important;
      }

      .nav-dropdown-item:hover {
        background: rgba(255, 255, 255, 0.25) !important;
        color: white !important;
      }
    }

    /* Ensure main content doesn't overlap navbar on ANY page */
    main,
    #main-content,
    .container,
    .main-content {
      margin-top: 0 !important;
      padding-top: 20px !important;
    }

    /* Force override for pages that might have different body styles */
    body.protein-details,
    body.docking-results,
    body[class*="page-"] {
      padding-top: 70px !important;
    }

    /* ENHANCED PROFESSIONAL FOOTER */
    .footer {
      background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #667eea 100%) !important;
      color: white !important;
      padding: 60px 0 20px 0 !important;
      margin-top: 80px !important;
      position: relative !important;
      overflow: hidden !important;
    }

    .footer::before {
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" fill="rgba(255,255,255,0.03)"><polygon points="0,0 1000,0 1000,100 0,100"></polygon><circle cx="200" cy="50" r="40"/><circle cx="800" cy="30" r="30"/><circle cx="600" cy="70" r="25"/></svg>') !important;
      opacity: 0.1 !important;
    }

    .footer-content {
      max-width: 1400px !important;
      margin: 0 auto !important;
      padding: 0 32px !important;
      position: relative !important;
      z-index: 2 !important;
    }

    .footer-main {
      display: block !important;
      margin-bottom: 40px !important;
    }

    .footer-brand {
      display: flex !important;
      flex-direction: column !important;
      gap: 20px !important;
    }

    .footer-brand .brand-info {
      display: flex !important;
      align-items: center !important;
      gap: 16px !important;
      margin-bottom: 16px !important;
    }

    .footer-brand .brand-logo {
      width: 48px !important;
      height: 48px !important;
      background: rgba(255, 255, 255, 0.1) !important;
      border-radius: 12px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      backdrop-filter: blur(10px) !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      overflow: hidden !important;
    }

    .footer-brand .brand-logo img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      border-radius: 10px !important;
    }

    .footer-brand .brand-text h3 {
      font-size: 24px !important;
      font-weight: 700 !important;
      margin: 0 0 4px 0 !important;
      background: linear-gradient(135deg, #ffffff, #e2e8f0) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      background-clip: text !important;
    }

    .footer-brand .brand-text p {
      font-size: 14px !important;
      margin: 0 !important;
      opacity: 0.8 !important;
      line-height: 1.4 !important;
    }

    .footer-brand .brand-description {
      font-size: 16px !important;
      line-height: 1.6 !important;
      opacity: 0.9 !important;
      margin: 0 !important;
    }

    .footer-social {
      display: flex !important;
      gap: 16px !important;
      margin-top: 16px !important;
    }

    .footer-social a {
      width: 44px !important;
      height: 44px !important;
      background: rgba(255, 255, 255, 0.1) !important;
      border-radius: 10px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: white !important;
      text-decoration: none !important;
      transition: all 0.3s ease !important;
      backdrop-filter: blur(10px) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
    }

    .footer-social a:hover {
      background: rgba(255, 255, 255, 0.2) !important;
      transform: translateY(-2px) !important;
      border-color: rgba(255, 255, 255, 0.3) !important;
    }

    .footer-column h4 {
      font-size: 18px !important;
      font-weight: 600 !important;
      margin: 0 0 24px 0 !important;
      color: white !important;
    }

    .footer-column ul {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .footer-column ul li {
      margin-bottom: 12px !important;
    }

    .footer-column ul li a {
      color: rgba(255, 255, 255, 0.8) !important;
      text-decoration: none !important;
      font-size: 14px !important;
      transition: all 0.3s ease !important;
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
    }

    .footer-column ul li a:hover {
      color: white !important;
      transform: translateX(4px) !important;
    }

    .footer-column ul li a i {
      font-size: 12px !important;
      opacity: 0.6 !important;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
      padding-top: 32px !important;
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      flex-wrap: wrap !important;
      gap: 16px !important;
    }

    .footer-bottom p {
      margin: 0 !important;
      font-size: 14px !important;
      opacity: 0.7 !important;
    }

    .footer-bottom .footer-links {
      display: flex !important;
      gap: 24px !important;
    }

    .footer-bottom .footer-links a {
      color: rgba(255, 255, 255, 0.8) !important;
      text-decoration: none !important;
      font-size: 14px !important;
      transition: color 0.3s ease !important;
    }

    .footer-bottom .footer-links a:hover {
      color: white !important;
    }

    @media (max-width: 1024px) {
      .footer-main {
        display: block !important;
      }
    }

    @media (max-width: 768px) {
      .footer {
        padding: 40px 0 20px 0 !important;
      }

      .footer-content {
        padding: 0 20px !important;
      }

      .footer-main {
        display: block !important;
        text-align: center !important;
      }

      .footer-bottom {
        flex-direction: column !important;
        text-align: center !important;
      }

      .footer-bottom .footer-links {
        gap: 20px !important;
      }
    }

    /* Loading and error states */
    .page-loading {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 99999;
      font-size: 1.2rem;
      color: white;
      flex-direction: column;
      gap: 20px;
    }

    .page-loading.hidden {
      display: none;
    }

    .spinner {
      width: 50px;
      height: 50px;
      border: 4px solid rgba(255, 255, 255, 0.3);
      border-top: 4px solid white;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    .error-boundary {
      padding: 20px;
      margin: 20px;
      border: 2px solid #dc3545;
      border-radius: 12px;
      background: #f8d7da;
      color: #721c24;
    }

    .error-boundary h3 {
      margin-top: 0;
      color: #721c24;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Glassmorphism effects */
    .glass-effect {
      background: rgba(255, 255, 255, 0.1) !important;
      backdrop-filter: blur(10px) !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      border-radius: 12px !important;
    }

    /* Smooth animations */
    .fade-in {
      animation: fadeIn 0.6s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>

  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Your other CSS files load AFTER the inline navbar styles -->
  <link rel="stylesheet" href="/style.css">

  <!-- Mol* Viewer Dependencies (only load when needed) -->
  <% if (typeof includeMolstar !=='undefined' && includeMolstar) { %>
    <link rel="stylesheet" type="text/css"
      href="https://www.ebi.ac.uk/pdbe/pdb-component-library/css/pdbe-molstar-3.1.0.css">
    <!-- Polyfill removed - modern browsers support ES6+ natively -->
    <% } %>

      <!-- Performance optimizations -->
      <link rel="preconnect" href="https://www.ebi.ac.uk">
      <link rel="dns-prefetch" href="https://www.ebi.ac.uk">

      <!-- Meta tags -->
      <meta name="description"
        content="HLA-DQ Protein Analysis Platform with advanced 3D visualization and docking analysis">
      <meta name="keywords" content="HLA-DQ, protein, docking, molecular visualization, bioinformatics">
      <meta name="author" content="HLA-DQ Research Platform">
      <link rel="icon" type="image/x-icon" href="/favicon.ico">
      <meta property="og:title" content="HLA-DQ Protein Analysis Platform">
      <meta property="og:description" content="Advanced protein analysis with 3D visualization">
      <meta property="og:type" content="website">
      <link rel="prefetch" href="https://3Dmol.org/build/3Dmol-min.js">
</head>

<body>
  <!-- Enhanced Page loading indicator -->
  <div id="pageLoading" class="page-loading">
    <div class="spinner"></div>
    <span>Loading Celiac DB...</span>
    <small style="opacity: 0.8; font-size: 0.9rem;">Initializing molecular visualization engine</small>
  </div>

  <!-- Skip to main content for accessibility -->
  <a href="#main-content" class="sr-only">Skip to main content</a>

  <!-- ENHANCED FIXED STICKY NAVBAR -->
  <header role="banner">
    <nav class="navbar" id="navbar">
