

<div class="container">
  <div class="header-section">
    <h2>HLA-DQ Proteins Database</h2>
    <p>View details and analysis for all HLA-DQ proteins</p>
    <a href="/" class="btn btn-secondary">← Back to Home</a>
  </div>

  <!-- Debug Info -->
  <div class="debug-info">
    <p><strong>Found <%= proteins.length %> proteins in database</strong></p>
  </div>

  <!-- Protein Selection Dropdown (like your old logic) -->
  <div class="selection-section">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title">📋 Select a Protein to View Details</h4>
        <form id="proteinForm" class="form-row">
          <select name="protein" id="proteinSelect" class="form-select">
            <option value="">Choose a protein...</option>
            <% proteins.forEach(protein => { %>
              <option value="<%= protein._id %>"><%= protein.name %></option>
            <% }) %>
          </select>
          <button class="btn btn-primary" type="submit">View Details</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Proteins Grid (showing all) -->
  <% if (proteins.length === 0) { %>
    <div class="no-proteins">
      <p>No proteins found in the database.</p>
    </div>
  <% } else { %>
    <div class="proteins-grid">
      <% proteins.forEach(protein => { %>
        <div class="protein-card">
          <div class="protein-header">
            <h3><%= protein.name %></h3>
            <span class="protein-type"><%= protein.proteinType || 'UNKNOWN' %></span>
          </div>
          
          <div class="protein-info">
            <p><strong>Total Files:</strong> <%= protein.files.length %></p>
            <p><strong>Docking Results:</strong> <%= protein.dockingResults.length %> peptides</p>
            <p><strong>Uploaded:</strong> <%= new Date(protein.uploadedAt).toLocaleDateString() %></p>
          </div>

          <% if (protein.analysis) { %>
            <div class="protein-analysis">
              <p><%= protein.analysis.substring(0, 150) %>...</p>
            </div>
          <% } %>

          <div class="protein-actions">
            <a href="/hladq-protein/<%= protein._id %>" class="btn btn-primary">View Details</a>
            <% if (protein.mainProteinFile) { %>
              <a href="/hladq-protein/<%= protein._id %>/download" class="btn btn-outline">Download PDB</a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Script for Dropdown Navigation (like your old logic) -->
<script>
document.getElementById('proteinForm')?.addEventListener('submit', function (e) {
  e.preventDefault();
  const select = document.getElementById('proteinSelect');
  if (select?.value) {
    window.location.href = `/hladq-protein/${select.value}`;
  }
});
</script>

