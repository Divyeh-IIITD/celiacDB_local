

<div class="container">
  <div class="header-section">
    <h2>Docking Analysis</h2>
    <p>Select an HLA-DQ protein and peptide to view docking results</p>
    <a href="/" class="btn btn-secondary">← Back to Home</a>
  </div>

  <div class="form-section">
    <form action="/docking-analysis" method="POST" class="docking-form">
      <div class="form-row">
        <div class="form-group">
          <label for="proteinSelect">Select HLA-DQ Protein:</label>
          <select id="proteinSelect" name="proteinId" required>
            <option value="">Choose a protein...</option>
            <% proteins.forEach(protein => { %>
              <option value="<%= protein._id %>"><%= protein.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="peptideSelect">Select Peptide:</label>
          <select id="peptideSelect" name="peptideName" required>
            <option value="">Choose a peptide...</option>
            <% peptides.forEach(peptide => { %>
              <option value="<%= peptide %>"><%= peptide %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">See Docking Results</button>
      </div>
    </form>
  </div>

  <!-- Info Section -->
  <div class="info-section">
    <h3>Available Data</h3>
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-number"><%= proteins.length %></span>
        <span class="stat-label">HLA-DQ Proteins</span>
      </div>
      <div class="stat-card">
        <span class="stat-number"><%= peptides.length %></span>
        <span class="stat-label">Peptides</span>
      </div>
    </div>

    <div class="protein-list">
      <h4>Available Proteins:</h4>
      <ul>
        <% proteins.forEach(protein => { %>
          <li>
            <strong><%= protein.name %></strong> 
            (<%= protein.dockingResults.length %> docking results)
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>

<script>
// Enable/disable peptide dropdown based on protein selection
document.getElementById('proteinSelect').addEventListener('change', function() {
  const proteinId = this.value;
  const peptideSelect = document.getElementById('peptideSelect');
  
  if (!proteinId) {
    peptideSelect.disabled = true;
    return;
  }
  
  peptideSelect.disabled = false;
  
  // You could add AJAX here to filter peptides by protein if needed
  // For now, showing all peptides
});

// Form validation
document.querySelector('.docking-form').addEventListener('submit', function(e) {
  const protein = document.getElementById('proteinSelect').value;
  const peptide = document.getElementById('peptideSelect').value;
  
  if (!protein || !peptide) {
    e.preventDefault();
    alert('Please select both a protein and a peptide.');
  }
});
</script>

