// Initialize the main Mol* viewer
function initializeMolstarViewer() {
  const loader = document.getElementById('viewer-loader');
  
  const options = {
    customData: {
      url: '/uploads/<%= pdbFile.storedName %>',
      format: 'pdb',
      binary: false
    },
    alphafoldView: false,
    bgColor: { r: 255, g: 255, b: 255 },
    hideControls: false,
    hideCanvasControls: ['expand', 'fullscreen'],
    sequencePanel: true,
    pdbeUrl: '/uploads/<%= pdbFile.storedName %>',
    loadMaps: false,
    validationAnnotation: false,
    domainAnnotation: true,
    lowPrecisionCoords: true,
    selectInteraction: true,
    lighting: 'matte',
    defaultPreset: 'default'
  };

  const viewerInstance = new PDBeMolstarPlugin();
  
  viewerInstance.render('proteinViewer', options).then(() => {
    console.log('✅ Advanced Mol* viewer loaded successfully');
    
    // Hide loader
    if (loader) {
      loader.style.display = 'none';
    }
    
    // Store viewer reference
    molstarViewer = viewerInstance;
    
    // Apply initial membrane-aware visualization
    setTimeout(() => {
      applyMembraneVisualization();
      
      // Hide any remaining Mol* built-in fullscreen/expand buttons
      hideMolstarExpandButtons();
      
      // Setup continuous monitoring for dynamically created buttons
      setupExpandButtonMonitoring();
    }, 2000);
    
  }).catch(error => {
    console.error('❌ Error loading Mol* viewer:', error);
    if (loader) {
      loader.innerHTML = '<div class="error-message">❌ Failed to load 3D structure</div>';
    }
  });
}

// Enhanced expand viewer function - FIXED for sticky navbar
function expandViewer() {
  try {
    console.log('🔍 Attempting to expand viewer...');
    
    const mainViewer = document.getElementById('proteinViewer');
    const viewerCard = mainViewer.closest('.viewer-card');
    const navbar = document.querySelector('.navbar');
    const navbarHeight = navbar ? navbar.offsetHeight : 60;
    
    if (viewerCard.classList.contains('expanded')) {
      // Collapse back to normal
      viewerCard.classList.remove('expanded');
      mainViewer.style.height = '500px';
      document.body.style.overflow = 'auto'; // Re-enable scrolling
      console.log('📱 Viewer collapsed to normal size');
    } else {
      // Expand the current viewer
      viewerCard.classList.add('expanded');
      
      // Calculate proper height accounting for navbar
      const availableHeight = window.innerHeight - navbarHeight - 160; // 160px for card padding/margins
      mainViewer.style.height = `${availableHeight}px`;
      
      // Disable body scrolling when expanded
      document.body.style.overflow = 'hidden';
      
      console.log('🖥️ Viewer expanded');
    }
    
    // Resize the existing viewer instead of creating a new one
    if (molstarViewer && molstarViewer.visual && molstarViewer.visual.resize) {
      setTimeout(() => {
        molstarViewer.visual.resize();
      }, 300);
    }
    
  } catch (error) {
    console.error('❌ Error expanding viewer:', error);
    alert('Unable to expand viewer. Please refresh the page and try again.');
  }
}

// Enhanced close fullscreen function
function closeFullscreen() {
  try {
    const viewerCard = document.querySelector('.viewer-card.expanded');
    const mainViewer = document.getElementById('proteinViewer');
    
    if (viewerCard) {
      viewerCard.classList.remove('expanded');
      mainViewer.style.height = '500px';
      document.body.style.overflow = 'auto'; // Re-enable scrolling
      
      // Resize the existing viewer
      if (molstarViewer && molstarViewer.visual && molstarViewer.visual.resize) {
        setTimeout(() => {
          molstarViewer.visual.resize();
        }, 300);
      }
    }
    
    console.log('✅ Viewer closed successfully');
  } catch (error) {
    console.error('❌ Error closing viewer:', error);
  }
}

// Handle window resize for expanded viewer
window.addEventListener('resize', () => {
  const expandedViewer = document.querySelector('.viewer-card.expanded');
  if (expandedViewer) {
    const mainViewer = document.getElementById('proteinViewer');
    const navbar = document.querySelector('.navbar');
    const navbarHeight = navbar ? navbar.offsetHeight : 60;
    const availableHeight = window.innerHeight - navbarHeight - 160;
    mainViewer.style.height = `${availableHeight}px`;
  }
  
  // Regular resize for Mol* viewer
  if (molstarViewer && molstarViewer.visual && molstarViewer.visual.resize) {
    molstarViewer.visual.resize();
  }
});

// Close expanded viewer with Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    const expandedViewer = document.querySelector('.viewer-card.expanded');
    if (expandedViewer) {
      closeFullscreen();
    }
  }
});

