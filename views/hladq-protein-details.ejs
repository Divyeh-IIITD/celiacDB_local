// Lazy loading for images
function setupLazyLoading() {
  const images = document.querySelectorAll('img[data-src]');
  
  if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target;
          img.src = img.dataset.src;
          img.classList.remove('lazy');
          imageObserver.unobserve(img);
        }
      });
    });
    
    images.forEach(img => imageObserver.observe(img));
  } else {
    // Fallback for older browsers
    images.forEach(img => {
      img.src = img.dataset.src;
    });
  }
}

// Hide ONLY Mol* built-in expand/fullscreen buttons (keep other controls)
function hideMolstarExpandButtons() {
  try {
    const molstarContainer = document.getElementById('proteinViewer');
    if (!molstarContainer) return;
    
    // Target ONLY expand/fullscreen related buttons, not other controls
    const expandButtonSelectors = [
      '.msp-btn-expand',
      '.msp-btn-fullscreen', 
      'button[title*="fullscreen"]',
      'button[title*="Fullscreen"]',
      'button[title*="expand"]',
      'button[title*="Expand"]'
    ];
    
    expandButtonSelectors.forEach(selector => {
      const buttons = molstarContainer.querySelectorAll(selector);
      buttons.forEach(button => {
        // Check if it's actually an expand/fullscreen button before hiding
        const title = button.getAttribute('title') || '';
        const textContent = button.textContent || '';
        
        if (title.toLowerCase().includes('expand') || 
            title.toLowerCase().includes('fullscreen') ||
            textContent.toLowerCase().includes('expand') ||
            textContent.toLowerCase().includes('fullscreen')) {
          
          button.style.display = 'none !important';
          button.style.visibility = 'hidden !important';
          button.disabled = true;
          button.onclick = null;
          
          console.log('🚫 Hidden Mol* expand button:', title || textContent);
        }
      });
    });
    
    console.log('✅ Mol* expand buttons hidden (other controls preserved)');
    
  } catch (error) {
    console.error('❌ Error hiding Mol* expand buttons:', error);
  }
}

// Monitor for expand buttons only (preserve other controls)
function setupExpandButtonMonitoring() {
  const molstarContainer = document.getElementById('proteinViewer');
  if (!molstarContainer) return;
  
  // Create a mutation observer to watch for new expand buttons only
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      mutation.addedNodes.forEach((node) => {
        if (node.nodeType === 1) { // Element node
          // Only check for expand/fullscreen buttons specifically
          const expandButtons = node.querySelectorAll ? 
            node.querySelectorAll('button[title*="expand"], button[title*="fullscreen"], .msp-btn-expand, .msp-btn-fullscreen') : [];
          
          if (expandButtons.length > 0) {
            hideMolstarExpandButtons();
          }
        }
      });
    });
  });
  
  // Start observing
  observer.observe(molstarContainer, {
    childList: true,
    subtree: true
  });
  
  console.log('👁️ Monitoring for Mol* expand buttons only...');
}

